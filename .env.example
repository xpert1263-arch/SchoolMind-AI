# SchoolMind — AskMySchool (v1.1)
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit a real key.
# This key is read only by the Node side (server/env.mjs). It is never
# bundled into the browser, so do NOT rename it to VITE_*.

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any Gemini model that supports Google Search grounding.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Set to "off" to disable live web search while keeping AI answers.
# ASKMYSCHOOL_WEB_SEARCH=on
