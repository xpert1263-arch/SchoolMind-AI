# SchoolMind — AskMySchool (v1.1)
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit a real key.
# This key is read only by the Node side (server/env.mjs). It is never
# bundled into the browser, so do NOT rename it to VITE_*.

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest. Pin a version if you need
# reproducible behaviour, e.g. gemini-3.7-flash.
# GEMINI_MODEL=gemini-flash-latest

# Optional. Set to "off" to disable live web search while keeping AI
# answers. Grounded Google Search needs a billed tier; on the free tier
# it returns 429 and SchoolMind degrades to a plain AI answer, labelled.
# ASKMYSCHOOL_WEB_SEARCH=on
