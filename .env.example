# SchoolMind (v1.6)
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit a real
# key. Every value here is read ONLY by the Node side (server/env.mjs)
# and never reaches the browser bundle.
#
# Do NOT rename any of these to VITE_*. That prefix is what puts a
# value into client-side JavaScript, where a secret becomes public.

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest. Pin a version if you need
# reproducible behaviour, e.g. gemini-3.7-flash.
# GEMINI_MODEL=gemini-flash-latest

# Optional. Set to "off" to disable live web search while keeping AI
# answers. Grounded Google Search needs a billed tier; on the free tier
# it returns 429. SchoolMind then WITHHOLDS the answer to a question
# about current information rather than answering it from stale model
# knowledge, and says it could not be verified.
# ASKMYSCHOOL_WEB_SEARCH=on

# Groq API key — https://console.groq.com/keys
# The secondary AI provider. Text only: it backs up the Planner, Tutor,
# Quiz, Teacher AI and general answers when Gemini is out of quota,
# busy or unreachable. It never handles images and never answers
# questions about live information, because it cannot cite a source.
# Leave empty to run on Gemini alone.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b, then a Llama fallback.
# GROQ_MODEL=openai/gpt-oss-120b

# Telegram bot token from @BotFather — https://t.me/BotFather
# Parent Connect delivery. Without it, parent records can still be
# stored and edited, but no connection link can be issued and no
# message can be delivered; the UI says so rather than pretending.
TELEGRAM_BOT_TOKEN=

# Optional. Set to "off" to stop the bot update loop while keeping the
# token configured.
# TELEGRAM_POLLING=on
